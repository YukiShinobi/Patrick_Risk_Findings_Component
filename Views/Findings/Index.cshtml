@model IEnumerable<MedicalDeviceSafetyPlatform.Models.Finding>
@{
    ViewData["Title"] = "My Findings";
}
<h1>My Findings</h1>
<p>Risk-review findings you have recorded against selected safety and recall notices.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not recorded any findings yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Notice</th><th>Finding</th><th>Relevance</th><th>Status</th><th>Updated</th><th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var finding in Model)
        {
            <tr>
                <td>@finding.SafetyNotice?.Reference</td>
                <td>@finding.Title</td>
                <td>@finding.Relevance</td>
                <td>@finding.Status</td>
                <td>@finding.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@finding.Id" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
        }
        </tbody>
    </table>
}
