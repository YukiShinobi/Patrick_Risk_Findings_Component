@model MedicalDeviceSafetyPlatform.ViewModels.FindingFormViewModel
@{ ViewData["Title"] = "Edit Finding"; }
<a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Back to finding</a>
<div class="eyebrow mt-3">RISK MANAGEMENT / UPDATE ASSESSMENT</div>
<h1 class="page-title">Edit risk finding</h1>
<p class="page-subtitle">Update the analysis, relevance or current status of this assessment.</p>
<section class="content-card form-panel"><div class="card-heading"><div><h2>Finding information</h2><p>Changes are saved to your employee record</p></div></div>
<div class="content-body"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><partial name="_FindingForm" model="Model" />
<div class="form-actions"><button type="submit" class="btn btn-primary">Save changes →</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }