@model MedicalDeviceSafetyPlatform.ViewModels.FindingFormViewModel
@{ ViewData["Title"] = "Add Finding"; }
<a asp-controller="Home" asp-action="Index" class="back-link">← Back to safety notices</a>
<div class="eyebrow mt-3">RISK MANAGEMENT / NEW ASSESSMENT</div>
<h1 class="page-title">Create risk finding</h1>
<p class="page-subtitle">Document an assessment of the selected medical device safety notice.</p>
<section class="content-card form-panel"><div class="card-heading"><div><h2>Finding information</h2><p>Complete the fields below to save your assessment</p></div></div>
<div class="content-body"><form asp-action="Create" method="post"><partial name="_FindingForm" model="Model" />
<div class="form-actions"><button type="submit" class="btn btn-primary">Save finding →</button><a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }