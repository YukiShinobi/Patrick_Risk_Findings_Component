@model MedicalDeviceSafetyPlatform.Models.Finding
@{
    ViewData["Title"] = "Finding Details";
}
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="d-flex justify-content-between align-items-start">
    <div>
        <small class="text-muted">@Model.SafetyNotice?.Reference</small>
        <h1>@Model.Title</h1>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit finding</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Device:</strong> @Model.SafetyNotice?.DeviceName</p>
        <p><strong>Relevance:</strong> @Model.Relevance</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <h2 class="h5">Risk-review analysis</h2>
        <p style="white-space: pre-wrap">@Model.Analysis</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h5">Employee comments</h2>
        @if (!Model.Comments.Any())
        {
            <p class="text-muted">No comments have been added.</p>
        }
        else
        {
            @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAtUtc))
            {
                <div class="border-bottom py-2">
                    <strong>@(comment.Author?.UserName ?? "Employee")</strong>
                    <small class="text-muted">@comment.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                    <div>@comment.Body</div>
                </div>
            }
        }

        <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" class="mt-3">
            <label for="body" class="form-label">Add comment</label>
            <textarea id="body" name="body" maxlength="1500" rows="3" class="form-control" required></textarea>
            <button class="btn btn-primary mt-2" type="submit">Add comment</button>
        </form>
    </div>
</div>
