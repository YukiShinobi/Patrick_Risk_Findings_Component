@model IEnumerable<MedicalDeviceSafetyPlatform.Models.SafetyNotice>
@{ ViewData["Title"] = User.Identity?.IsAuthenticated == true ? "Dashboard" : "Welcome"; var notices = Model.ToList(); }
@if (User.Identity?.IsAuthenticated != true)
{
<section class="winters-landing" aria-labelledby="winters-title">
    <div class="winters-scene" aria-hidden="true"></div>

    <header class="winters-identity">
        <span class="winters-symbol" aria-hidden="true">✚</span>
        <h1 class="winters-wordmark" id="winters-title">Winters <span>Hospitals</span></h1>
    </header>

    <div class="winters-welcome">
        <div class="winters-rule" aria-hidden="true"></div>
        <p class="winters-overline">MEDICAL DEVICE SAFETY PLATFORM</p>
        <h2>Care begins<br />with confidence.</h2>
        <p>A secure place to review device safety notices, document risk assessments and manage employee findings.</p>
    </div>

    <div class="winters-access">
        <a class="winters-login" asp-controller="Account" asp-action="Login">
            Employee login <span class="winters-login-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="winters-secondary" asp-controller="Account" asp-action="Register">New employee? Create an account</a>
    </div>

    <footer class="winters-footer">
        <span>Winters Hospitals · Medical Device Safety</span>
        <span>Secure employee access</span>
    </footer>
</section>
}
else
{
<section class="hero-panel">
<div class="eyebrow" style="color:#a9d2ff">RISK MANAGEMENT WORKSPACE</div>
<h1>Safety starts with visibility.</h1>
<p>Review medical device safety notices, document risk findings and maintain an auditable record of employee observations.</p>
@if (User.Identity?.IsAuthenticated != true) { <a class="btn btn-light" asp-controller="Account" asp-action="Register">Create employee account →</a> }
else { <a class="btn btn-light" asp-controller="Findings" asp-action="Index">View my findings →</a> }
</section>
<section class="stat-grid" aria-label="Dashboard overview">
<div class="stat-card"><div class="stat-label">Available safety notices</div><div class="stat-number">@notices.Count</div><div class="stat-note">Ready for risk assessment</div></div>
<div class="stat-card"><div class="stat-label">Component</div><div class="stat-number" style="font-size:22px">Risk Findings</div><div class="stat-note">Employee observations &amp; comments</div></div>
<div class="stat-card"><div class="stat-label">Workspace access</div><div class="stat-number" style="font-size:22px">@(User.Identity?.IsAuthenticated == true ? "Employee" : "Guest")</div><div class="stat-note">@(User.Identity?.IsAuthenticated == true ? "Signed in" : "Sign in to record findings")</div></div>
</section>
<section class="content-card">
<div class="card-heading"><div><h2>Safety notice register</h2><p>Select a notice to document a new risk finding</p></div><span class="badge-soft">@notices.Count notices</span></div>
<div class="table-responsive"><table class="table align-middle">
<thead><tr><th>Notice reference</th><th>Medical device</th><th>Assessment</th><th>Action</th></tr></thead>
<tbody>
@foreach(var notice in notices) {
<tr><td><span class="reference-code">@notice.Reference</span></td><td><span class="device-name">@notice.DeviceName</span></td><td><span class="badge-soft">Ready for review</span></td><td><a class="btn btn-outline-primary btn-sm" asp-controller="Findings" asp-action="Create" asp-route-safetyNoticeId="@notice.Id">Add finding →</a></td></tr>
}
@if (!notices.Any()) { <tr><td colspan="4" class="text-center text-secondary py-4">No safety notices available.</td></tr> }
</tbody></table></div>
</section>
}
