@{
    var isGuestLanding =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Index" &&
        User.Identity?.IsAuthenticated != true;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] | Winters Hospitals</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
@if (isGuestLanding) { <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" /> }
</head>
<body class="@(isGuestLanding ? "winters-public-page" : "")">
<div class="app-shell">
<aside class="side-nav">
<a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">✚</span><span>Winters Hospitals<small>SAFETY PLATFORM</small></span></a>
<nav aria-label="Main navigation">
<div class="nav-label">Workspace</div>
<a class="nav-link-app @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">◫ <span>Dashboard</span></a>
<a class="nav-link-app @(ViewContext.RouteData.Values["controller"]?.ToString() == "Findings" ? "active" : "")" asp-controller="Findings" asp-action="Index">▤ <span>My Findings</span></a>
</nav>
<div class="side-footer">Risk findings &amp; employee comments<br/>Individual component demonstration</div>
</aside>
<div class="main-area">
<header class="topbar">
<div class="topbar-title">Medical Device Safety <span class="text-secondary fw-normal">/ @ViewData["Title"]</span></div>
<div class="d-flex align-items-center gap-2">
@if (User.Identity?.IsAuthenticated == true) {
<span class="user-chip" title="@User.Identity.Name">@User.Identity.Name</span>
<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm" type="submit">Log out</button></form>
} else {
<a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
<a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
}
</div>
</header>
<main class="page-content">@RenderBody()<div class="footer-note">Winters Hospitals • Individual risk findings demonstration • @DateTime.UtcNow.Year</div></main>
</div>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>